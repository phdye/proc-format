#!/bin/bash
#
# f-identical: Compare two files for functional equivalence
# 
# Removes all whitespace and line endings, then compares file size and checksums.
# If identical, the files differ only in formatting (no functional changes).
#
# Usage: f-identical [options] <file1> <file2>
#
# Options:
#   -v, --verbose    Show detailed comparison information
#   -q, --quiet      Only set exit code (0=same, 1=different, 2=error)
#   -k, --keep-temp  Keep temporary files for inspection
#   -h, --help       Show this help message
#
# Exit codes:
#   0 - Files are functionally identical
#   1 - Files are functionally different
#   2 - Error (missing files, invalid arguments, etc.)

set -euo pipefail

# Default options
VERBOSE=0
QUIET=0
KEEP_TEMP=0

# Color codes for output
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    NC='\033[0m' # No Color
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

# Function to show usage
usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

# Function to log messages
log() {
    if [[ $QUIET -eq 0 ]]; then
        echo -e "$@"
    fi
}

log_verbose() {
    if [[ $VERBOSE -eq 1 && $QUIET -eq 0 ]]; then
        echo -e "${BLUE}[VERBOSE]${NC} $@"
    fi
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $@" >&2
}

log_success() {
    log "${GREEN}[SUCCESS]${NC} $@"
}

log_warning() {
    log "${YELLOW}[WARNING]${NC} $@"
}

# Parse command line arguments
FILE1=""
FILE2=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -q|--quiet)
            QUIET=1
            shift
            ;;
        -k|--keep-temp)
            KEEP_TEMP=1
            shift
            ;;
        -h|--help)
            usage 0
            ;;
        -*)
            log_error "Unknown option: $1"
            usage 2
            ;;
        *)
            if [[ -z "$FILE1" ]]; then
                FILE1="$1"
            elif [[ -z "$FILE2" ]]; then
                FILE2="$1"
            else
                log_error "Too many arguments"
                usage 2
            fi
            shift
            ;;
    esac
done

# Validate arguments
if [[ -z "$FILE1" || -z "$FILE2" ]]; then
    log_error "Both file arguments are required"
    usage 2
fi

if [[ ! -f "$FILE1" ]]; then
    log_error "File not found: $FILE1"
    exit 2
fi

if [[ ! -f "$FILE2" ]]; then
    log_error "File not found: $FILE2"
    exit 2
fi

# Create temporary directory
TEMP_DIR=$(mktemp -d -t same-func.XXXXXXXXXX)
TEMP1="${TEMP_DIR}/file1.normalized"
TEMP2="${TEMP_DIR}/file2.normalized"

# Cleanup function
cleanup() {
    if [[ $KEEP_TEMP -eq 0 ]]; then
        log_verbose "Cleaning up temporary files: $TEMP_DIR"
        rm -rf "$TEMP_DIR"
    else
        log_warning "Temporary files kept at: $TEMP_DIR"
        log_warning "  - $TEMP1"
        log_warning "  - $TEMP2"
    fi
}

trap cleanup EXIT

# Normalize files (remove all whitespace and line endings)
log_verbose "Normalizing $FILE1 -> $TEMP1"
tr -d '[:space:]' < "$FILE1" > "$TEMP1"

log_verbose "Normalizing $FILE2 -> $TEMP2"
tr -d '[:space:]' < "$FILE2" > "$TEMP2"

# Get file sizes
SIZE1=$(stat -c%s "$TEMP1" 2>/dev/null || stat -f%z "$TEMP1" 2>/dev/null)
SIZE2=$(stat -c%s "$TEMP2" 2>/dev/null || stat -f%z "$TEMP2" 2>/dev/null)

log_verbose "Normalized sizes: $SIZE1 vs $SIZE2 bytes"

# Compare sizes first (quick check)
if [[ "$SIZE1" -ne "$SIZE2" ]]; then
    log "Files are ${RED}functionally DIFFERENT${NC}"
    log "  Size difference: $SIZE1 vs $SIZE2 bytes"
    exit 1
fi

# Calculate checksums
log_verbose "Computing checksums..."
read -r CKSUM1 _ < <(cksum "$TEMP1")
read -r CKSUM2 _ < <(cksum "$TEMP2")

if [[ $VERBOSE -eq 1 ]]; then
    log_verbose "Checksums:"
    log_verbose "  $FILE1: $CKSUM1"
    log_verbose "  $FILE2: $CKSUM2"
fi

# Compare checksums
if [[ "$CKSUM1" == "$CKSUM2" ]]; then
    log_success "Files are ${GREEN}functionally IDENTICAL${NC}"
    log "  Both files have same content after whitespace normalization"
    log "  Size: $SIZE1 bytes, Checksum: $CKSUM1"
    exit 0
else
    log "Files are ${RED}functionally DIFFERENT${NC}"
    log "  Different checksums: $CKSUM1 vs $CKSUM2"
    exit 1
fi
